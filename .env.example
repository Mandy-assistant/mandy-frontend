# Where Next.js forwards /api/v1 (server-side rewrite). The browser always calls /api/v1 on this origin.
API_PROXY_TARGET=http://localhost:8000

# Only set this if the browser must call the API directly (then the API must allow CORS with credentials).
# NEXT_PUBLIC_API_URL=/api/v1

# Public URL of the frontend (used for Open Graph image links)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
